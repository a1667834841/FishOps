{
  "name": "fishops-agent-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "FishOps 本地 Agent API：native host 与最小执行扩展",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --test-timeout=15000 packages/protocol/src/*.test.ts apps/host/src/*.test.ts apps/extension/src/test/*.test.ts",
    "test:integration": "node --test scripts/test/integration.test.mjs scripts/test/orchestration.test.mjs scripts/test/report.test.mjs scripts/test/runtime.test.mjs scripts/test/lifecycle-observer.test.mjs scripts/test/local-chat-contract.test.mjs scripts/test/send-replay-behavior.test.mjs scripts/test/gap-ledger-process.test.mjs",
    "test:local-chat-contract": "node scripts/test/local-chat-contract.mjs",
    "test:chat-sync-behavior": "node scripts/test/chat-sync-behavior.mjs",
    "test:chat-sync-status-behavior": "node scripts/test/sync-status-behavior.mjs",
    "test:browser-smoke": "node scripts/test/browser-smoke.mjs",
    "test:install": "node --test scripts/test/install.test.mjs",
    "test:artifacts": "node --test scripts/test/artifacts.test.mjs scripts/test/page-bundle.test.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "build": "npm run build --workspace @fishops/extension",
    "verify": "node scripts/verify.mjs verify",
    "regression": "node scripts/verify.mjs regression",
    "regression:e2e": "node scripts/verify.mjs e2e",
    "regression:full": "node scripts/verify.mjs full",
    "host:install": "node scripts/install-host.mjs",
    "host:uninstall": "node scripts/install-host.mjs --uninstall",
    "prebuild": "node scripts/check-runtime.mjs",
    "test:lifecycle-observe": "node scripts/test/lifecycle-observer.mjs",
    "test:ego-lifecycle-trigger": "node scripts/test/ego-lifecycle-trigger.mjs",
    "test:ego-extension-reload": "node scripts/test/ego-extension-reload.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
