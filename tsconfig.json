{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"], "strict": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true, "erasableSyntaxOnly": true,
    "types": ["node", "chrome"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts"],
  "exclude": ["**/dist/**", "legacy", "node_modules"]
}
