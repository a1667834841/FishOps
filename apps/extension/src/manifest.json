{
  "manifest_version": 3,
  "name": "FishOps Agent Bridge",
  "version": "0.2.0",
  "description": "FishOps Agent API 执行扩展：连接本地 native host，响应 system.status 并推送 account.changed。",
  "key": "",
  "minimum_chrome_version": "105",
  "permissions": [
    "nativeMessaging",
    "cookies",
    "tabs",
    "scripting",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "https://*.goofish.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.goofish.com/*"
      ],
      "js": [
        "page-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.goofish.com/*"
      ],
      "js": [
        "chat-content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FishOps Agent Bridge：点击重连本地 host"
  }
}
