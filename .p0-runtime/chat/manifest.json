{
  "manifest_version": 3,
  "name": "闲鱼聊天监听助手",
  "version": "3.0.0",
  "description": "监听闲鱼聊天WebSocket消息，解析并存储聊天记录",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "https://www.goofish.com/*",
    "https://h5api.m.goofish.com/*",
    "https://open.goofish.pro/*"
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "options_page": "options/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "inject/api/chat-sender.js",
        "inject/api/chat-history.js",
        "inject/api/chat-sync.js",
        "inject/api/find-my-id.js",
        "inject/api/user-api.js",
        "inject/api/goods-api.js",
        "test/test-ai-pause.js"
      ],
      "matches": [
        "https://www.goofish.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.goofish.com/*"
      ],
      "js": [
        "content/bus-isolated.js",
        "content/index.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.goofish.com/*"
      ],
      "js": [
        "inject/events/event-bus.js",
        "content/bus-main.js",
        "inject/api/find-my-id.js",
        "inject/api/user-api.js",
        "inject/api/goods-api.js",
        "inject/chat-parser.js",
        "inject/handlers/print-processor.js",
        "inject/handlers/auto-reply-processor.js",
        "inject/events/message-bridge.js",
        "inject/websocket/websocket-data-source.js",
        "inject/api/chat-sender.js",
        "inject/api/chat-history.js",
        "inject/api/chat-sync.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "闲鱼聊天监听助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}